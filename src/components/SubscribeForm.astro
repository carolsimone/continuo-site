---
import { site } from '../../site.config';
// Substack blocks the no-JS POST endpoint (403), so the subscribe UI uses
// Substack's own embed widget served from the publication URL.
---
<div class="subscribe">
  <span class="micro">Get the deep pieces by email</span>
  <iframe src={`${site.substackUrl}/embed`} title="Subscribe" width="100%" height="150" loading="lazy"></iframe>
  <p class="subscribe__hint">One deep piece every two weeks. Unsubscribe in one click.</p>
</div>
